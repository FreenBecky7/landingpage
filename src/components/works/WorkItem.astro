---
export interface Props {
    id: string
    image: string
    name: string
    description: string
    url: string
}

const { id, image, name, description, url } = Astro.props
---

<div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1">
    <a href={`/${id}`} class="block overflow-hidden rounded-lg">
        <img class="w-full h-48 object-cover rounded-lg transition-transform duration-500 hover:scale-105" src={image} alt={name} />
    </a>
    <div class="mt-4">
        <h4 class="text-2xl font-semibold text-gray-900 dark:text-white">{name}</h4>
        <p class="text-gray-600 dark:text-gray-400 mt-2">{description}</p>
        <a href={url} target="_blank" class="mt-4 inline-block bg-[#8a38a1] text-white px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300 hover:bg-[#722c85] hover:shadow-lg">
            Ver más
        </a>
    </div>
</div>
