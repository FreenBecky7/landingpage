---
export interface Props {
  id: string;
  image: string;
  name: string;
  description: string;
  author: string;
  year: number;
  tech: string[];
  highlights: string[];
}
const { id, image, name, description, author, year, tech, highlights } = Astro.props;
---

<li class="work-item border rounded-lg shadow-lg bg-white dark:bg-[#121e2b] text-[#0B0F1A] dark:text-white max-w-md mx-auto">
  <img src={image} alt={name} class="w-full h-48 object-cover rounded-t-lg" />
  <div class="p-6">
    <h3 class="text-2xl font-semibold mb-2">{name}</h3>
    <p class="text-sm text-gray-700 dark:text-gray-300 mb-4">{description}</p>

    <div class="text-center">
      <button
        data-id={id}
        class="toggle-btn inline-block bg-[#a515a5] text-white px-4 py-2 rounded-md hover:bg-[#62e0ff] transition"
        aria-expanded="false"
        aria-controls={`details-${id}`}
        type="button"
      >
        Ver más
      </button>
    </div>

    <div
      id={`details-${id}`}
      class="mt-4 border-t border-gray-300 dark:border-gray-700 pt-4 text-left text-sm hidden"
    >
      <ul class="space-y-1">
        <li><strong>Autor:</strong> {author}</li>
        <li><strong>Año:</strong> {year}</li>
        <li><strong>Tecnologías:</strong> {tech.join(", ")}</li>
        <li>
          <strong>Destacado:</strong>
          <ul class="list-disc list-inside ml-4 mt-1">
            {highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </li>
      </ul>
    </div>
  </div>
</li>
