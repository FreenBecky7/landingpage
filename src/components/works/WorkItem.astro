---
export interface Props {
  id: string
  image: string
  name: string
  description: string
  url: string
}

const { id, image, name, description, url } = Astro.props
---

<section class="bg-gradient-to-b from-white via-[#CBD5E1] to-white dark:from-[#0f2c66] dark:via-[#133D93] dark:to-[#0f2c66] py-12 px-4 transition-colors duration-300 rounded-xl">
  <div class="max-w-4xl mx-auto">
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1">
      <a href={`/${id}`} class="block overflow-hidden rounded-xl">
        <img 
          class="w-full h-48 object-cover rounded-xl transition-transform duration-500 hover:scale-105 shadow-md" 
          src={image} 
          alt={name} 
        />
      </a>
      <div class="mt-4">
        <h4 class="text-2xl font-semibold text-[#133D93] dark:text-white">{name}</h4>
        <p class="text-[#1a1a1a] dark:text-[#f0f0f0] mt-2">{description}</p>
        <a 
          href={url} 
          target="_blank" 
          class="mt-4 inline-block bg-[#133D93] text-white px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300 hover:bg-[#0F2F72] hover:shadow-lg"
        >
          Ver más
        </a>
      </div>
    </div>
  </div>
</section>
