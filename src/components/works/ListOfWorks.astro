---
import WorkItem from "./WorkItem.astro";
import { works } from "../../data/works";
---

<section class="bg-gradient-to-b from-[#E1E5EA] to-[#F4F6F8] dark:from-[#121E2B] dark:via-[#0B0F1A] dark:to-[#0B0F1A] py-12 px-4 transition-colors duration-300 rounded-xl">
  <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
    {
      works.map(({ id, image, name, description, url }) => {
        return (
          <li>
            <WorkItem id={id} image={image} name={name} description={description} url={url} />
          </li>
        );
      })
    }
  </ul>
</section>
