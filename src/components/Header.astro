<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />

  <!-- Evita parpadeo -->
  <script>
    (function () {
      const theme = localStorage.getItem('theme');
      if (
        theme === 'dark' ||
        (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kimstrong</title>

  <!-- Tailwind CDN -->
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@3.0.0/dist/tailwind.min.css" rel="stylesheet" />

  <style>
    html, body {
      transition: background-color 0.4s, color 0.4s;
      font-family: 'Poppins', sans-serif;
      scroll-behavior: smooth;
    }

    body {
      background-color: #F4F6F8;
      color: #1A1A1A;
    }

    .dark body {
      background-color: #0B0F1A;
      color: #ECEFF1;
    }

    header {
      backdrop-filter: blur(16px);
      transition: background-color 0.3s ease;
      background-color: rgba(225, 229, 234, 0.8);
    }

    .dark header {
      background-color: rgba(18, 30, 43, 0.85);
    }

    /* Links */
    .link-hover {
      position: relative;
      font-size: 1.25rem;
      font-weight: 600;
    }

    .link-hover::after {
      content: "";
      position: absolute;
      width: 0%;
      height: 2px;
      bottom: -4px;
      left: 0;
      background-color: #4A6FA5;
      transition: width 0.3s;
    }

    .dark .link-hover::after {
      background-color: #62e0ff;
    }

    .link-hover:hover::after {
      width: 100%;
    }

    /* Menú móvil */
    .mobile-menu {
      position: fixed;
      top: 0;
      right: -100%;
      width: 80%;
      height: 100vh;
      background: rgba(225, 229, 234, 0.9);
      backdrop-filter: blur(16px);
      box-shadow: -4px 0 30px rgba(0,0,0,0.2);
      transition: right 0.4s ease, opacity 0.4s ease;
      z-index: 50;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 1.5rem;
      border-top-left-radius: 24px;
      border-bottom-left-radius: 24px;
      opacity: 0;
    }

    .dark .mobile-menu {
      background: rgba(18, 30, 43, 0.96);
    }

    .mobile-menu.open {
      right: 0;
      opacity: 1;
    }

    .overlay {
      display: none;
      position: fixed;
      inset: 0;
      background-color: rgba(0,0,0,0.5);
      z-index: 40;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .overlay.show {
      display: block;
      opacity: 1;
    }

    /* Botón hamburguesa */
    .menu-btn {
      position: relative;
      width: 26px;
      height: 22px;
      cursor: pointer;
    }

    .menu-btn span {
      position: absolute;
      height: 3px;
      width: 100%;
      background: currentColor;
      border-radius: 2px;
      transition: all 0.3s ease;
    }

    .menu-btn span:nth-child(1) { top: 0; }
    .menu-btn span:nth-child(2) { top: 9px; }
    .menu-btn span:nth-child(3) { top: 18px; }

    .menu-btn.open span:nth-child(1) {
      transform: rotate(45deg);
      top: 9px;
    }
    .menu-btn.open span:nth-child(2) {
      opacity: 0;
    }
    .menu-btn.open span:nth-child(3) {
      transform: rotate(-45deg);
      top: 9px;
    }

    /* Botón Dark Mode (Netlify safe) */
    .theme-btn {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      transition: background-color 0.3s;
    }

    .theme-btn:hover {
      background: rgba(0,0,0,0.1);
    }

    .dark .theme-btn:hover {
      background: rgba(255,255,255,0.12);
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <header class="fixed top-0 left-0 right-0 z-50 shadow-sm">
    <div class="max-w-7xl mx-auto px-6 sm:px-8">
      <div class="flex justify-between items-center h-20">

        <!-- LOGO -->
        <a href="/" class="flex items-center gap-2 group">
          <img src="./img/21.png" alt="Logo Kimstrong"
            class="w-16 h-16 object-contain transition-transform duration-300 group-hover:scale-105" />
          <span class="text-2xl sm:text-3xl font-bold bg-gradient-to-r from-[#a515a5] to-[#62e0ff] bg-clip-text text-transparent">
            Kim<strong>strong</strong>
          </span>
        </a>

        <!-- Desktop -->
        <nav class="hidden md:flex gap-10 items-center text-lg font-medium">
          <a href="/" class="link-hover">Inicio</a>
          <a href="/mas-informacion" class="link-hover">Servicios</a>
          <a href="#projects" class="link-hover">Proyectos</a>
          <a href="#paquetes" class="link-hover">Paquetes</a>
          <a href="#redessociales" class="link-hover">Contacto</a>
        </nav>

        <!-- Botones -->
        <div class="flex items-center gap-5">
          <!-- BOTÓN DARK MODE CORREGIDO -->
          <button
            id="toggleDark"
            type="button"
            class="theme-btn text-xl"
            onclick="toggleTheme()"
            aria-label="Cambiar tema"
          >
            <span id="themeIcon">🌙</span>
          </button>

          <div id="menu-toggle" class="menu-btn md:hidden">
            <span></span><span></span><span></span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="mobile-menu md:hidden">
    <nav class="flex flex-col items-center gap-6">
      <a href="/" class="link-hover">Inicio</a>
      <a href="/mas-informacion" class="link-hover">Servicios</a>
      <a href="#projects" class="link-hover">Ver Proyectos</a>
      <a href="#paquetes" class="link-hover">Paquetes</a>
      <a href="#redessociales" class="link-hover">Contacto</a>
    </nav>
  </div>

  <div id="overlay" class="overlay"></div>

  <div class="h-20"></div>

  <!-- JS GENERAL -->
  <script>
    const html = document.documentElement;
    const themeIcon = document.getElementById('themeIcon');

    function syncIcon() {
      themeIcon.textContent = html.classList.contains('dark') ? '☀️' : '🌙';
    }

    function toggleTheme() {
      html.classList.toggle('dark');
      localStorage.setItem(
        'theme',
        html.classList.contains('dark') ? 'dark' : 'light'
      );
      syncIcon();
    }

    syncIcon();

    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('overlay');

    menuToggle.addEventListener('click', () => {
      const open = mobileMenu.classList.toggle('open');
      overlay.classList.toggle('show', open);
      menuToggle.classList.toggle('open', open);
    });

    overlay.addEventListener('click', () => {
      mobileMenu.classList.remove('open');
      overlay.classList.remove('show');
      menuToggle.classList.remove('open');
    });
  </script>

</body>
</html>
