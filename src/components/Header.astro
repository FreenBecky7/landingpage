<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kimstrong</title>

  <!-- Dark mode AUTOMÁTICO (CSS, 100% compatible con Netlify y móviles) -->
  <style>
    :root {
      color-scheme: light dark;
    }
  </style>

  <!-- Tailwind CDN -->
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@3.0.0/dist/tailwind.min.css" rel="stylesheet" />

  <style>
    html, body {
      transition: background-color 0.4s, color 0.4s;
      font-family: 'Poppins', sans-serif;
      scroll-behavior: smooth;
    }

    header {
      backdrop-filter: blur(16px);
    }

    /* ===== MENÚ MÓVIL ===== */
    .mobile-menu {
      position: fixed;
      top: 0;
      right: -100%;
      width: 80%;
      height: 100vh;
      background: rgba(225, 229, 234, 0.95);
      backdrop-filter: blur(16px);
      transition: right 0.4s ease, opacity 0.4s ease;
      z-index: 50;
      display: flex;
      justify-content: center;
      align-items: center;
      opacity: 0;
    }

    @media (prefers-color-scheme: dark) {
      .mobile-menu {
        background: rgba(18, 30, 43, 0.96);
      }
    }

    .mobile-menu.open {
      right: 0;
      opacity: 1;
    }

    .overlay {
      display: none;
      position: fixed;
      inset: 0;
      background-color: rgba(0,0,0,0.5);
      z-index: 40;
    }

    .overlay.show {
      display: block;
    }

    /* ===== BOTÓN HAMBURGUESA ===== */
    .menu-btn {
      width: 26px;
      height: 22px;
      position: relative;
      cursor: pointer;
    }

    .menu-btn span {
      position: absolute;
      width: 100%;
      height: 3px;
      background: currentColor;
      border-radius: 2px;
      transition: 0.3s;
    }

    .menu-btn span:nth-child(1){top:0}
    .menu-btn span:nth-child(2){top:9px}
    .menu-btn span:nth-child(3){top:18px}

    .menu-btn.open span:nth-child(1){transform:rotate(45deg);top:9px}
    .menu-btn.open span:nth-child(2){opacity:0}
    .menu-btn.open span:nth-child(3){transform:rotate(-45deg);top:9px}

    .link-hover {
      font-size: 1.25rem;
      font-weight: 600;
      position: relative;
    }

    .link-hover::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -4px;
      width: 0;
      height: 2px;
      background: #4A6FA5;
      transition: width .3s;
    }

    .link-hover:hover::after { width: 100%; }
  </style>
</head>

<body class="bg-[#F4F6F8] text-[#1A1A1A] dark:bg-[#0B0F1A] dark:text-[#ECEFF1]">

<header class="fixed top-0 inset-x-0 z-50 bg-[#E1E5EA]/80 dark:bg-[#121E2B]/80">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex justify-between items-center h-20">

      <!-- LOGO -->
      <a href="/" class="flex items-center gap-2">
        <img src="./img/21.png" class="w-14 h-14" />
        <span class="text-2xl font-bold bg-gradient-to-r from-[#a515a5] to-[#62e0ff] bg-clip-text text-transparent">
          Kim<strong>strong</strong>
        </span>
      </a>

      <!-- DESKTOP -->
      <nav class="hidden md:flex gap-10 text-lg font-medium">
        <a href="/" class="link-hover">Inicio</a>
        <a href="/mas-informacion" class="link-hover">Servicios</a>
        <a href="#projects" class="link-hover">Proyectos</a>
        <a href="#paquetes" class="link-hover">Paquetes</a>
        <a href="#redessociales" class="link-hover">Contacto</a>
      </nav>

      <!-- BOTÓN MÓVIL -->
      <div id="menu-toggle" class="menu-btn md:hidden">
        <span></span><span></span><span></span>
      </div>
    </div>
  </div>
</header>

<!-- MENÚ MÓVIL -->
<div id="mobile-menu" class="mobile-menu md:hidden">
  <nav class="flex flex-col gap-6 text-center">
    <a href="/" class="link-hover">Inicio</a>
    <a href="/mas-informacion" class="link-hover">Servicios</a>
    <a href="#projects" class="link-hover">Proyectos</a>
    <a href="#paquetes" class="link-hover">Paquetes</a>
    <a href="#redessociales" class="link-hover">Contacto</a>
  </nav>
</div>
<div id="overlay" class="overlay"></div>
<div class="h-20"></div>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('overlay');

  btn.onclick = () => {
    btn.classList.toggle('open');
    menu.classList.toggle('open');
    overlay.classList.toggle('show');
  };

  overlay.onclick = () => {
    btn.classList.remove('open');
    menu.classList.remove('open');
    overlay.classList.remove('show');
  };
</script>

</body>
</html>