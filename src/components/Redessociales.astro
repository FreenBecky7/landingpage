<!DOCTYPE html>
<html lang="es" class="light"> <!-- Cambia a "dark" si quieres iniciar en oscuro -->
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contáctanos | Kimstrong</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@3.3.0/dist/tailwind.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    html {
      height: 100%;
    }
    body {
      min-height: 100%;
      margin: 0;
      padding: 0;
      background-color: #ffffff;
      transition: background-color 0.3s ease;
    }
    html.dark body {
      background-color: #111C29;
    }
  </style>
</head>
<body class="text-gray-900 dark:text-white font-sans">

  <section class="flex items-center justify-center min-h-screen px-4 sm:px-6 lg:px-8">
    <div class="bg-white dark:bg-[#111C29] border border-gray-200 dark:border-[#2D3A55] rounded-3xl shadow-2xl p-10 w-full max-w-3xl transition-all duration-300">
      
      <!-- Título -->
      <div class="text-center mb-8">
        <h2 class="text-4xl font-bold text-[#0B0F1A] dark:text-white mb-2">Contáctanos</h2>
        <p class="text-md text-gray-700 dark:text-gray-300">Estamos aquí para ayudarte. ¡Conéctate con nosotros!</p>
      </div>

      <!-- Redes sociales -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
        <a href="https://www.instagram.com/yeraay_mc" target="_blank"
           class="flex items-center justify-center gap-3 px-6 py-4 bg-[#1E3A8A] dark:bg-[#1B3C7C] text-white font-semibold rounded-xl shadow-md hover:scale-105 transition duration-200">
          <i class="fab fa-instagram text-xl"></i> Instagram
        </a>
        <a href="https://www.facebook.com/yeraay.mc" target="_blank"
           class="flex items-center justify-center gap-3 px-6 py-4 bg-[#0F2C66] dark:bg-[#1B3C7C] text-white font-semibold rounded-xl shadow-md hover:scale-105 transition duration-200">
          <i class="fab fa-facebook text-xl"></i> Facebook
        </a>
        <a href="https://wa.me/+524921202836" target="_blank"
           class="flex items-center justify-center gap-3 px-6 py-4 bg-[#128C7E] text-white font-semibold rounded-xl shadow-md hover:scale-105 transition duration-200">
          <i class="fab fa-whatsapp text-xl"></i> WhatsApp
        </a>
        <a href="https://twitter.com/aprasranet" target="_blank"
           class="flex items-center justify-center gap-3 px-6 py-4 bg-[#1DA1F2] text-white font-semibold rounded-xl shadow-md hover:scale-105 transition duration-200">
          <i class="fab fa-twitter text-xl"></i> Twitter
        </a>
      </div>

      <!-- Línea divisora -->
      <div class="my-8 border-t border-gray-300 dark:border-gray-600"></div>

      <!-- Correo -->
      <div class="text-center">
        <p class="text-lg text-gray-700 dark:text-gray-300 mb-2">¿Prefieres escribirnos?</p>
        <a href="mailto:contacto@srchfreenbeck.com"
           class="font-semibold text-lg text-[#0B0F1A] dark:text-[#CBD5E1] hover:underline transition duration-200">
          srchfreenbeck@gmail.com
        </a>
      </div>
    </div>
  </section>

</body>
</html>
