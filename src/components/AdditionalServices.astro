<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Servicios de Programación</title>
  <!-- Incluyendo Tailwind CSS desde CDN para propósitos de prueba -->
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@3.0.0/dist/tailwind.min.css" rel="stylesheet">
</head>
<body>
  <section class="py-16 bg-gray-100 dark:bg-gray-800 h-full">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold mb-8 text-center text-gray-900 dark:text-white">
        Nuestros Paquetes de Programación
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Paquete Básico -->
        <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg transition-transform transform hover:-translate-y-2">
          <h3 class="text-xl font-semibold mb-4 text-gray-800 dark:text-gray-200">
            Paquete Básico
          </h3>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            Desarrollamos páginas web sencillas con un máximo de 5 secciones, diseño responsivo y optimización básica para SEO.
          </p>
          <ul class="text-gray-600 dark:text-gray-400 mb-4">
            <li>- Hasta 5 secciones</li>
            <li>- Diseño responsivo</li>
            <li>- SEO básico</li>
            <li>- Integración con redes sociales</li>
          </ul>
          <p class="font-semibold text-gray-800 dark:text-gray-200">Precio: $4,800 - $7,000 MXN</p>
          <a href="#contact" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">
            Aprende más
          </a>
        </div>

        <!-- Paquete Intermedio -->
        <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg transition-transform transform hover:-translate-y-2">
          <h3 class="text-xl font-semibold mb-4 text-gray-800 dark:text-gray-200">
            Paquete Intermedio
          </h3>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            Incluye páginas web interactivas con funciones como formularios y chat en vivo, además de animaciones personalizadas.
          </p>
          <ul class="text-gray-600 dark:text-gray-400 mb-4">
            <li>- Todo lo del Paquete Básico</li>
            <li>- Funcionalidades interactivas</li>
            <li>- Animaciones personalizadas</li>
            <li>- Integración con APIs externas</li>
          </ul>
          <p class="font-semibold text-gray-800 dark:text-gray-200">Precio: $8,800 - $20,000 MXN</p>
          <a href="#contact" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">
            Aprende más
          </a>
        </div>

        <!-- Paquete Avanzado -->
        <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg transition-transform transform hover:-translate-y-2">
          <h3 class="text-xl font-semibold mb-4 text-gray-800 dark:text-gray-200">
            Paquete Avanzado
          </h3>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            Desarrollo personalizado con base de datos, autenticación de usuarios y optimización avanzada para SEO.
          </p>
          <ul class="text-gray-600 dark:text-gray-400 mb-4">
            <li>- Todo lo del Paquete Intermedio</li>
            <li>- Desarrollo personalizado</li>
            <li>- Base de datos</li>
            <li>- Autenticación de usuarios</li>
            <li>- Optimización avanzada de SEO</li>
          </ul>
          <p class="font-semibold text-gray-800 dark:text-gray-200">Precio: Desde $20,000 MXN</p>
          <a href="#contact" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline">
            Aprende más
          </a>
        </div>
      </div>
    </div>
  </section>
</body>
</html>
