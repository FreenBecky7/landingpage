<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Servicios de Programación</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#F4F6F8] dark:bg-[#0B0F1A] text-black dark:text-white">

  <!-- Sección de Paquetes -->
  <section id="paquetes" class="p-8">
    <div class="container mx-auto px-4">
      <h3 class="text-3xl mb-8 text-black dark:text-white text-center font-extrabold tracking-wide">
        Nuestros Paquetes de Programación
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

        <!-- Paquete Básico -->
        <div class="bg-white dark:bg-[#1C2A40] p-6 rounded-lg shadow-2xl border dark:border-[#2D3A55] transition-transform transform hover:-translate-y-2">
          <h3 class="text-xl font-semibold mb-4 text-black dark:text-white">Paquete Básico</h3>
          <p class="mb-4 text-black dark:text-[#CBD5E1]">
            Perfecto para quienes quieren su primera página web. Diseño responsivo y SEO básico.
          </p>
          <ul class="list-disc pl-6 mb-4 text-black dark:text-[#B0BEC5]">
            <li>Hasta 5 secciones</li>
            <li>Diseño adaptable a móviles</li>
            <li>SEO básico para buscadores</li>
            <li>Integración con redes sociales</li>
          </ul>
          <p class="font-semibold text-black dark:text-[#8FB0DA]">Precio: $4,800 - $7,000 MXN</p>
        </div>

        <!-- Paquete Intermedio -->
        <div class="bg-white dark:bg-[#1C2A40] p-6 rounded-lg shadow-2xl border dark:border-[#2D3A55] transition-transform transform hover:-translate-y-2">
          <h3 class="text-xl font-semibold mb-4 text-black dark:text-white">Paquete Intermedio</h3>
          <p class="mb-4 text-black dark:text-[#CBD5E1]">
            Ideal para negocios que quieren interactuar con sus clientes. Incluye animaciones y formularios.
          </p>
          <ul class="list-disc pl-6 mb-4 text-black dark:text-[#B0BEC5]">
            <li>Todo lo del Paquete Básico</li>
            <li>Formularios y chat en vivo</li>
            <li>Animaciones personalizadas</li>
            <li>Integración con APIs externas</li>
          </ul>
          <p class="font-semibold text-black dark:text-[#8FB0DA]">Precio: $8,800 - $20,000 MXN</p>
        </div>

        <!-- Paquete Avanzado -->
        <div class="bg-white dark:bg-[#1C2A40] p-6 rounded-lg shadow-2xl border dark:border-[#2D3A55] transition-transform transform hover:-translate-y-2">
          <h3 class="text-xl font-semibold mb-4 text-black dark:text-white">Paquete Avanzado</h3>
          <p class="mb-4 text-black dark:text-[#CBD5E1]">
            Para proyectos profesionales que requieren funcionalidades complejas y seguridad avanzada.
          </p>
          <ul class="list-disc pl-6 mb-4 text-black dark:text-[#B0BEC5]">
            <li>Todo lo del Paquete Intermedio</li>
            <li>Desarrollo web personalizado</li>
            <li>Base de datos y autenticación de usuarios</li>
            <li>SEO avanzado</li>
          </ul>
          <p class="font-semibold text-black dark:text-[#8FB0DA]">Precio: Desde $20,000 MXN</p>
        </div>

      </div>
    </div>
  </section>

</body>
</html>
