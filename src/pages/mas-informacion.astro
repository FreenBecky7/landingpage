 <!-- Contacto -->
<section id="contacto" class="bg-[#f5f7fa] dark:bg-[#122c66] py-16 px-6 max-w-3xl mx-auto mt-20 rounded-3xl shadow-2xl">
  <h3 class="text-4xl font-bold text-center text-[#0a1f44] dark:text-white mb-10 animate__animated animate__fadeInDown">
    Contáctanos
  </h3>
  <form id="form-contacto" class="bg-white dark:bg-[#1a2f66] p-8 rounded-xl shadow-md space-y-6">
    <div>
      <label for="nombre" class="block mb-2 text-lg font-medium text-gray-900 dark:text-gray-200">Nombre Completo</label>
      <input name="nombre" id="nombre" type="text" required
        class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] transition" />
    </div>
    <div>
      <label for="email" class="block mb-2 text-lg font-medium text-gray-900 dark:text-gray-200">Correo Electrónico</label>
      <input name="email" id="email" type="email" required
        class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] transition" />
    </div>
    <div>
      <label for="mensaje" class="block mb-2 text-lg font-medium text-gray-900 dark:text-gray-200">Mensaje</label>
      <textarea name="mensaje" id="mensaje" rows="5" required
        class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a] transition"></textarea>
    </div>
    <button type="submit"
      class="w-full bg-[#1e3a8a] hover:bg-[#12306f] text-white text-lg font-semibold py-3 rounded-lg shadow transition duration-300">
      Enviar Mensaje
    </button>
    <p id="mensaje-exito" class="text-center text-green-600 dark:text-green-400 hidden mt-4">¡Mensaje enviado con éxito!</p>
  </form>
</section>

<!-- EmailJS Script -->
<script src="https://cdn.emailjs.com/dist/email.min.js"></script>
<script>
  emailjs.init('YOUR_PUBLIC_KEY'); // Reemplaza con tu clave pública de EmailJS

  document.getElementById('form-contacto').addEventListener('submit', function (e) {
    e.preventDefault();
    emailjs.sendForm('YOUR_SERVICE_ID', 'YOUR_TEMPLATE_ID', this)
      .then(function () {
        document.getElementById('mensaje-exito').classList.remove('hidden');
        document.getElementById('form-contacto').reset();
      }, function (error) {
        alert('Ocurrió un error al enviar el mensaje. Intenta más tarde.');
        console.error(error);
      });
  });
</script>

  <!-- SCRIPTS -->
  <script>
    // Tema oscuro/claro
    const html = document.documentElement;
    const toggleBtn = document.getElementById('toggleDark');
    const iconMoon = document.getElementById('icon-moon');
    const iconSun = document.getElementById('icon-sun');
    toggleBtn.addEventListener('click', () => {
      html.classList.toggle('dark');
      iconMoon.classList.toggle('hidden', html.classList.contains('dark'));
      iconSun.classList.toggle('hidden', !html.classList.contains('dark'));
      localStorage.theme = html.classList.contains('dark') ? 'dark' : 'light';
    });
    if (localStorage.theme === 'dark') {
      html.classList.add('dark');
      iconMoon.classList.add('hidden');
      iconSun.classList.remove('hidden');
    }

    // Menú móvil toggle
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    // Función simulada para enviar formulario
    function enviarFormulario(event) {
      event.preventDefault();
      alert('Gracias por contactarnos, responderemos pronto.');
      event.target.reset();
      return false;
    }
  </script>

