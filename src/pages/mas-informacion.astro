<!-- Mascota flotante profesional y responsive -->
<div id="mascota" class="fixed bottom-6 right-6 w-16 h-16 z-50 cursor-pointer transition-transform duration-300 hover:scale-110">
  <img src="/img/mascota.png" alt="Asistente web" class="w-full h-full rounded-full shadow-xl object-cover" />
  <div id="mascota-bubble" class="absolute bottom-full right-1/2 translate-x-1/2 mb-2 px-3 py-2 bg-white/95 dark:bg-[#1A1F2C]/95 text-[#1A1A1A] dark:text-[#ECEFF1] rounded-xl shadow-lg text-xs sm:text-sm max-w-[180px] text-center backdrop-blur-sm opacity-0 transition-all duration-300">
    Bienvenido!
  </div>
</div>

<script>
const bubble = document.getElementById("mascota-bubble");

// Mensajes cortos y claros para cada sección
const mensajes = {
  default: "¡Hola! 😻 Explora mi web.",
  servicios: "Servicios: Web, Apps, Marketing y Juegos 🎯",
  proyectos: "Proyectos destacados 🚀",
  videojuegos: "🎮 Brain Trap: recolecta cerebros y esquiva enemigos.",
  proceso: "Mi proceso de trabajo: Idea, Planificación, Desarrollo y Entrega ⚡",
  blog: "Tips y recursos para mejorar tu web 📚",
  experiencia: "Nuestra experiencia: +3 años, +20 proyectos, +20 clientes felices 👏",
  contacto: "Agenda tu cita 📝 rápidamente",
  final: "¡Llegaste al final de la página! Gracias por visitar 👏"
};

// Función para actualizar mensaje según la sección visible o si llegamos al final
function actualizarMensaje() {
  const secciones = document.querySelectorAll("section[id]");
  let mensajeActual = mensajes.default;

  // Detectar sección visible
  secciones.forEach(sec => {
    const rect = sec.getBoundingClientRect();
    if(rect.top <= window.innerHeight/2 && rect.bottom >= window.innerHeight/2){
      mensajeActual = mensajes[sec.id] || mensajes.default;
    }
  });

  // Detectar si llegamos al final del documento
  const scrollPosition = window.scrollY + window.innerHeight;
  const pageHeight = document.documentElement.scrollHeight;
  if(scrollPosition >= pageHeight - 50){ // 50px de margen
    mensajeActual = mensajes.final;
  }

  // Actualizar burbuja solo si cambió
  if(bubble.textContent !== mensajeActual){
    bubble.style.opacity = 0;
    setTimeout(() => {
      bubble.textContent = mensajeActual;
      bubble.style.opacity = 1;
    }, 150);
  }
}

// Mostrar burbuja siempre
bubble.style.opacity = 1;

// Actualizar mensaje al cargar, hacer scroll o redimensionar
window.addEventListener("scroll", actualizarMensaje);
window.addEventListener("load", actualizarMensaje);
window.addEventListener("resize", actualizarMensaje);
</script>


  <!-- SCRIPTS -->
  <script>
    // Tema oscuro/claro
    const html = document.documentElement;
    const toggleBtn = document.getElementById('toggleDark');
    const iconMoon = document.getElementById('icon-moon');
    const iconSun = document.getElementById('icon-sun');
    toggleBtn.addEventListener('click', () => {
      html.classList.toggle('dark');
      iconMoon.classList.toggle('hidden', html.classList.contains('dark'));
      iconSun.classList.toggle('hidden', !html.classList.contains('dark'));
      localStorage.theme = html.classList.contains('dark') ? 'dark' : 'light';
    });
    if (localStorage.theme === 'dark') {
      html.classList.add('dark');
      iconMoon.classList.add('hidden');
      iconSun.classList.remove('hidden');
    }

    // Menú móvil toggle
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    // Función simulada para enviar formulario
    function enviarFormulario(event) {
      event.preventDefault();
      alert('Gracias por contactarnos, responderemos pronto.');
      event.target.reset();
      return false;
    }
  </script>
