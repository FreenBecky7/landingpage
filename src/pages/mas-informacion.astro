<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kimstrong | Navbar y Secciones</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@3.0.0/dist/tailwind.min.css" rel="stylesheet" />
  <style>
    html, body {
      transition: background-color 0.3s, color 0.3s;
    }
    .backdrop-blur {
      backdrop-filter: blur(10px);
    }
  </style>
</head>
<body class="bg-white text-gray-900 dark:bg-[#0f2c66] dark:text-white">

  <!-- NAVBAR -->
  <header class="backdrop-blur bg-white/70 dark:bg-[#102b5c]/80 shadow-md fixed top-0 left-0 right-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-20">

        <!-- Logo y nombre -->
        <a href="/" class="flex items-center space-x-3">
          <img src="/img/logito.png" class="w-10 h-10 sm:w-14 sm:h-14 object-contain" alt="Logo Kimstrong" />
          <span class="text-2xl sm:text-3xl font-bold text-[#1A237E] dark:text-[#F8BBD0] tracking-wide">Kimstrong</span>
        </a>

        <!-- Botón hamburguesa móvil -->
        <button id="menu-toggle" class="md:hidden text-2xl focus:outline-none">
          ☰
        </button>

        <!-- Menú principal -->
        <nav id="main-nav" class="hidden md:flex gap-8 items-center text-lg font-semibold text-black dark:text-gray-100">
          <a href="#" class="hover:text-[#FEB6B9] transition">Inicio</a>
          <a href="#" class="hover:text-[#FEB6B9] transition">Servicios</a>
          <a href="#" class="hover:text-[#FEB6B9] transition">Proyectos</a>
          <a href="#" class="hover:text-[#FEB6B9] transition">Contacto</a>
        </nav>

        <!-- Botón modo oscuro -->
        <button id="toggleDark" class="ml-4 text-xl p-2 rounded-full hover:bg-gray-200 dark:hover:bg-[#1a3b71] transition">
          <span id="icon-moon" class="block dark:hidden">🌙</span>
          <span id="icon-sun" class="hidden dark:block">☀️</span>
        </button>
      </div>

      <!-- Menú móvil -->
      <div id="mobile-menu" class="md:hidden hidden flex-col space-y-4 py-4 px-4 bg-white dark:bg-[#102b5c] rounded-b-lg shadow-md text-lg font-semibold text-black dark:text-gray-100">
        <a href="#" class="hover:text-[#FEB6B9] transition">Inicio</a>
        <a href="#" class="hover:text-[#FEB6B9] transition">Servicios</a>
        <a href="#" class="hover:text-[#FEB6B9] transition">Proyectos</a>
        <a href="#" class="hover:text-[#FEB6B9] transition">Contacto</a>
      </div>
    </div>
  </header>

  <!-- Espaciador para la navbar fija -->
  <div class="h-20"></div>

  <!-- Hero Section -->
  <section class="py-20 text-center">
    <h2 class="text-4xl md:text-6xl font-bold mb-4 text-azul dark:text-white">Impulsamos Tu Negocio</h2>
    <p class="text-xl text-gray-700 dark:text-gray-300">Soluciones digitales innovadoras para potenciar tu empresa</p>
  </section>

  <!-- Servicios -->
  <section class="bg-white dark:bg-gray-800 rounded-t-3xl py-16 px-6">
    <h3 class="text-3xl font-bold text-center text-azul dark:text-white mb-12">Nuestros Servicios</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-rosa2 p-6 rounded-xl shadow-md dark:bg-gray-700">
        <h4 class="text-xl font-bold mb-2">Desarrollo Web</h4>
        <p>Diseños modernos y funcionales para destacar tu presencia online.</p>
      </div>
      <div class="bg-rosa2 p-6 rounded-xl shadow-md dark:bg-gray-700">
        <h4 class="text-xl font-bold mb-2">Aplicaciones Móviles</h4>
        <p>Apps a medida para Android e iOS adaptadas a tus necesidades.</p>
      </div>
      <div class="bg-rosa2 p-6 rounded-xl shadow-md dark:bg-gray-700">
        <h4 class="text-xl font-bold mb-2">Marketing Digital</h4>
        <p>Estrategias digitales para atraer, convertir y fidelizar clientes.</p>
      </div>
    </div>
  </section>

  <!-- Script modo oscuro y menú -->
  <script>
    const toggleBtn = document.getElementById('toggleDark');
    const html = document.documentElement;
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconMoon = document.getElementById('icon-moon');
    const iconSun = document.getElementById('icon-sun');

    // Alternar modo oscuro
    toggleBtn.addEventListener('click', () => {
      html.classList.toggle('dark');
      const isDark = html.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateIcons();
    });

    // Mantener tema entre sesiones
    if (localStorage.getItem('theme') === 'dark') {
      html.classList.add('dark');
    } else {
      html.classList.remove('dark');
    }
    updateIcons();

    function updateIcons() {
      const isDark = html.classList.contains('dark');
      iconMoon.classList.toggle('hidden', isDark);
      iconSun.classList.toggle('hidden', !isDark);
    }

    // Menú móvil
    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  </script>

</body>
</html>
