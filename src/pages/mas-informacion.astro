<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Kimstrong - Servicios Profesionales</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@3.3.2/dist/tailwind.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
  <style>
    html, body {
      transition: background-color 0.3s, color 0.3s;
    }
    .backdrop-blur {
      backdrop-filter: blur(10px);
    }
    /* Carrusel básico */
    .carousel {
      scroll-snap-type: x mandatory;
      overflow-x: auto;
      display: flex;
      gap: 1rem;
      scroll-padding-left: 1rem;
      -webkit-overflow-scrolling: touch;
    }
    .carousel::-webkit-scrollbar {
      display: none;
    }
    .carousel-item {
      scroll-snap-align: start;
      flex: 0 0 80%;
      border-radius: 1rem;
      overflow: hidden;
      box-shadow: 0 8px 16px rgb(0 0 0 / 0.25);
      background: white;
      color: #0f2c66;
    }
    @media (min-width: 768px) {
      .carousel-item {
        flex: 0 0 40%;
      }
    }
  </style>
</head>
<body class="bg-white text-gray-900 dark:bg-[#0f2c66] dark:text-white">

  <!-- NAVBAR -->
  <header class="backdrop-blur bg-white/70 dark:bg-[#102b5c]/80 shadow-md fixed w-full z-50">
    <div class="max-w-7xl mx-auto flex justify-between items-center h-20 px-4 sm:px-6 lg:px-8">
      <a href="#" class="flex items-center">
       <img src="/img/logooo.png" class="w-28 h-28 sm:w-36 sm:h-36 object-contain" alt="Logo Nayafaye" />
        <span class="ml-3 font-bold text-xl text-[#0a1f44] dark:text-white"></span>
      </a>
      <button id="menu-toggle" class="md:hidden text-2xl" aria-label="Menú móvil">☰</button>
      <nav id="main-nav" class="hidden md:flex gap-8 text-lg font-semibold">
        <a href="#servicios" class="hover:text-[#1e3a8a] dark:hover:text-[#9ec1f7]">Servicios</a>
        <a href="#proyectos" class="hover:text-[#1e3a8a] dark:hover:text-[#9ec1f7]">Proyectos</a>
        <a href="#videojuegos" class="hover:text-[#1e3a8a] dark:hover:text-[#9ec1f7]">Videojuegos</a>
        <a href="#contacto" class="hover:text-[#1e3a8a] dark:hover:text-[#9ec1f7]">Contacto</a>
      </nav>
      <button id="toggleDark" class="ml-4 text-xl p-2 rounded-full" aria-label="Cambiar tema">
        <span id="icon-moon">🌙</span>
        <span id="icon-sun" class="hidden">☀️</span>
      </button>
    </div>
    <div id="mobile-menu" class="md:hidden hidden flex-col space-y-4 bg-white dark:bg-[#102b5c] p-4 rounded-b-lg text-lg font-semibold">
      <a href="#servicios" class="hover:text-[#1e3a8a] dark:hover:text-[#9ec1f7]">Servicios</a>
      <a href="#proyectos" class="hover:text-[#1e3a8a] dark:hover:text-[#9ec1f7]">Proyectos</a>
      <a href="#videojuegos" class="hover:text-[#1e3a8a] dark:hover:text-[#9ec1f7]">Videojuegos</a>
      <a href="#contacto" class="hover:text-[#1e3a8a] dark:hover:text-[#9ec1f7]">Contacto</a>
    </div>
  </header>
  <div class="h-20"></div>

  <!-- SECCIÓN SERVICIOS -->
  <section id="servicios" class="bg-white dark:bg-gray-800 py-16 px-6 rounded-t-3xl max-w-7xl mx-auto">
    <h3 class="text-3xl font-bold text-center text-[#0a1f44] dark:text-white mb-12 animate__animated animate__fadeInDown">
      Nuestros Servicios
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">

      <!-- Servicio 1 -->
      <article class="bg-white dark:bg-gray-700 rounded-xl shadow-md hover:shadow-lg transition duration-300 animate__animated animate__fadeInUp animate__delay-1s">
        <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Desarrollo Web" class="rounded-t-xl w-full h-48 object-cover" />
        <div class="p-6">
          <h4 class="text-xl font-bold text-[#1e3a8a] mb-2">Desarrollo Web</h4>
          <p class="text-gray-700 dark:text-gray-300">
            Diseño y desarrollo de sitios web con estética minimalista y UX impecable.
          </p>
        </div>
      </article>

      <!-- Servicio 2 -->
      <article class="bg-white dark:bg-gray-700 rounded-xl shadow-md hover:shadow-lg transition duration-300 animate__animated animate__fadeInUp animate__delay-2s">
        <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Apps móviles" class="rounded-t-xl w-full h-48 object-cover" />
        <div class="p-6">
          <h4 class="text-xl font-bold text-[#1e3a8a] mb-2">Aplicaciones Móviles</h4>
          <p class="text-gray-700 dark:text-gray-300">
            Apps nativas e híbridas con interfaces limpias y rendimiento optimizado.
          </p>
        </div>
      </article>

      <!-- Servicio 3 -->
      <article class="bg-white dark:bg-gray-700 rounded-xl shadow-md hover:shadow-lg transition duration-300 animate__animated animate__fadeInUp animate__delay-3s">
        <img src="https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Marketing Digital" class="rounded-t-xl w-full h-48 object-cover" />
        <div class="p-6">
          <h4 class="text-xl font-bold text-[#1e3a8a] mb-2">Marketing Digital</h4>
          <p class="text-gray-700 dark:text-gray-300">
            Estrategias digitales con diseño minimalista y enfoque en conversión.
          </p>
        </div>
      </article>

      <!-- Servicio 4 -->
      <article class="bg-white dark:bg-gray-700 rounded-xl shadow-md hover:shadow-lg transition duration-300 animate__animated animate__fadeInUp animate__delay-4s">
        <img src="https://images.unsplash.com/photo-1515377905703-c4788e51af15?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Videojuegos en Godot" class="rounded-t-xl w-full h-48 object-cover" />
        <div class="p-6">
          <h4 class="text-xl font-bold text-[#1e3a8a] mb-2">Videojuegos en Godot</h4>
          <p class="text-gray-700 dark:text-gray-300">
            Prototipos y juegos 2D elegantes y funcionales, creados con Godot Engine.
          </p>
        </div>
      </article>

    </div>
    <div class="max-w-3xl mx-auto text-center mt-14 animate__animated animate__fadeInUp">
      <p class="text-gray-600 dark:text-gray-300 text-lg">
        Cada proyecto cuenta con <strong>revisión de calidad</strong>, <strong>optimizaciones de rendimiento</strong> y <strong>soporte post lanzamiento</strong> para garantizar una experiencia impecable desde el diseño hasta la entrega.
      </p>
    </div>
  </section>

 <!-- SECCIÓN PROYECTOS DESTACADOS CON CARRUSEL PROFESIONAL -->
<section id="proyectos" class="bg-[#f5f7fa] dark:bg-[#122c66] py-16 px-0 w-full mt-20">
  <h3 class="text-3xl font-bold text-center text-[#0a1f44] dark:text-white mb-12 animate__animated animate__fadeInDown">
    Proyectos Destacados
  </h3>

  <div class="relative overflow-hidden w-full">
    <div id="carouselContainer" class="flex transition-transform duration-700 ease-in-out w-full">
      <!-- Proyecto 1 -->
      <article class="min-w-full px-6 box-border">
        <div class="p-6 bg-white dark:bg-[#1a2f66] max-w-7xl mx-auto rounded-3xl">
          <img src="https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" alt="Proyecto Ecommerce" class="rounded-xl w-full h-64 object-cover mb-6" />
          <h4 class="text-2xl font-bold mb-2 dark:text-white">Ecommerce Minimalista</h4>
          <p class="text-gray-700 dark:text-gray-300 text-lg">Plataforma de comercio electrónico con diseño limpio, UI/UX optimizada y pago seguro.</p>
        </div>
      </article>

      <!-- Proyecto 2 -->
      <article class="min-w-full px-6 box-border">
        <div class="p-6 bg-white dark:bg-[#1a2f66] max-w-7xl mx-auto rounded-3xl">
          <img src="https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" alt="Proyecto App Móvil" class="rounded-xl w-full h-64 object-cover mb-6" />
          <h4 class="text-2xl font-bold mb-2 dark:text-white">App para Gestión de Tareas</h4>
          <p class="text-gray-700 dark:text-gray-300 text-lg">Aplicación móvil con diseño minimalista para mejorar productividad y gestión diaria.</p>
        </div>
      </article>

      <!-- Proyecto 3 -->
      <article class="min-w-full px-6 box-border">
        <div class="p-6 bg-white dark:bg-[#1a2f66] max-w-7xl mx-auto rounded-3xl">
          <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" alt="Proyecto Marketing Digital" class="rounded-xl w-full h-64 object-cover mb-6" />
          <h4 class="text-2xl font-bold mb-2 dark:text-white">Campaña Marketing Digital</h4>
          <p class="text-gray-700 dark:text-gray-300 text-lg">Estrategias con diseño enfocado en conversión y experiencia de usuario.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  // Autoplay del carrusel
  let currentIndex = 0;
  const carousel = document.getElementById("carouselContainer");
  const totalItems = carousel.children.length;

  setInterval(() => {
    currentIndex = (currentIndex + 1) % totalItems;
    carousel.style.transform = `translateX(-${currentIndex * 100}%)`;
  }, 5000); // cambia cada 5 segundos
</script>


  <!-- SECCIÓN GALERÍA VIDEOJUEGOS -->
  <section id="videojuegos" class="bg-white dark:bg-gray-800 py-16 px-6 max-w-7xl mx-auto mt-20 rounded-3xl">
    <h3 class="text-3xl font-bold text-center text-[#0a1f44] dark:text-white mb-12 animate__animated animate__fadeInDown">
      Videojuegos en Godot
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
      <div class="overflow-hidden rounded-xl shadow-lg hover:scale-105 transition-transform duration-300">
        <img src="https://cdn.pixabay.com/photo/2020/07/12/19/24/gaming-5404217_1280.jpg" alt="Juego 1" class="w-full h-48 object-cover" />
      </div>
      <div class="overflow-hidden rounded-xl shadow-lg hover:scale-105 transition-transform duration-300">
        <img src="https://cdn.pixabay.com/photo/2021/01/11/21/27/game-5907667_1280.jpg" alt="Juego 2" class="w-full h-48 object-cover" />
      </div>
      <div class="overflow-hidden rounded-xl shadow-lg hover:scale-105 transition-transform duration-300">
        <img src="https://cdn.pixabay.com/photo/2017/08/28/21/39/joystick-2693066_1280.jpg" alt="Juego 3" class="w-full h-48 object-cover" />
      </div>
    </div>
    <p class="mt-6 max-w-xl mx-auto text-center text-gray-700 dark:text-gray-300">
      Prototipos y juegos 2D elegantes y funcionales, desarrollados con pasión y el motor Godot.
    </p>
  </section>

  <!-- SECCIÓN FORMULARIO CONTACTO -->
  <section id="contacto" class="bg-[#f5f7fa] dark:bg-[#122c66] py-16 px-6 max-w-3xl mx-auto mt-20 rounded-3xl">
    <h3 class="text-3xl font-bold text-center text-[#0a1f44] dark:text-white mb-8 animate__animated animate__fadeInDown">
      Contáctanos
    </h3>
    <form class="bg-white dark:bg-[#1a2f66] p-8 rounded-xl shadow-md" onsubmit="return enviarFormulario(event)">
      <div class="mb-6">
        <label for="nombre" class="block mb-2 font-semibold text-gray-900 dark:text-gray-200">Nombre Completo</label>
        <input id="nombre" type="text" required class="w-full p-3 rounded border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a]" />
      </div>
      <div class="mb-6">
        <label for="email" class="block mb-2 font-semibold text-gray-900 dark:text-gray-200">Correo Electrónico</label>
        <input id="email" type="email" required class="w-full p-3 rounded border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a]" />
      </div>
      <div class="mb-6">
        <label for="mensaje" class="block mb-2 font-semibold text-gray-900 dark:text-gray-200">Mensaje</label>
        <textarea id="mensaje" rows="5" required class="w-full p-3 rounded border border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-2 focus:ring-[#1e3a8a]"></textarea>
      </div>
      <button type="submit" class="w-full bg-[#1e3a8a] hover:bg-[#12306f] text-white font-bold py-3 rounded transition">
        Enviar Mensaje
      </button>
    </form>
  </section>

  <!-- SCRIPTS -->
  <script>
    // Tema oscuro/claro
    const html = document.documentElement;
    const toggleBtn = document.getElementById('toggleDark');
    const iconMoon = document.getElementById('icon-moon');
    const iconSun = document.getElementById('icon-sun');
    toggleBtn.addEventListener('click', () => {
      html.classList.toggle('dark');
      iconMoon.classList.toggle('hidden', html.classList.contains('dark'));
      iconSun.classList.toggle('hidden', !html.classList.contains('dark'));
      localStorage.theme = html.classList.contains('dark') ? 'dark' : 'light';
    });
    if (localStorage.theme === 'dark') {
      html.classList.add('dark');
      iconMoon.classList.add('hidden');
      iconSun.classList.remove('hidden');
    }

    // Menú móvil toggle
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    // Función simulada para enviar formulario
    function enviarFormulario(event) {
      event.preventDefault();
      alert('Gracias por contactarnos, responderemos pronto.');
      event.target.reset();
      return false;
    }
  </script>

</body>
</html>
